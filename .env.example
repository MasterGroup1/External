# Copy to .env for local builds, and add both to Vercel → Project → Settings →
# Environment Variables (Production, Preview and Development).
# Both values are in Supabase → Project Settings → API.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# The "anon" / "public" key (NOT the service_role key — that one must never
# go in a browser app).
SUPABASE_ANON_KEY=
